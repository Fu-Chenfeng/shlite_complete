# Copy with ./robotctl init; settings apply to every terminal automatically.
COMPOSE_PROJECT_NAME=shlite_complete
HOST_UID=1000
HOST_GID=1000
DISPLAY=:0
LIBGL_ALWAYS_SOFTWARE=1
ROS_PORT=11311
PC_IP=10.9.11.1
NUC_IP=10.9.11.186
NUC_USER=user
NUC_CONTAINER=dexterous_hand
SSH_KEY=~/.ssh/shadow_nuc
UR5_IP=192.168.1.10
# Empty means use the original driver's automatic reverse-IP detection.
UR5_REVERSE_IP=
SHADOW_IMAGE=public.ecr.aws/shadowrobot/dexterous-hand:noetic-release
UR5_IMAGE=shlite-complete-ur5:noetic
