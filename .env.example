# Copy with ./robotctl init; settings apply to every terminal automatically.
COMPOSE_PROJECT_NAME=shlite_complete
HOST_UID=1000
HOST_GID=1000
DISPLAY=:0
LIBGL_ALWAYS_SOFTWARE=1
# Network/robot/scene/planner settings are in config.yaml.
SHADOW_IMAGE=public.ecr.aws/shadowrobot/dexterous-hand:noetic-release
UR5_IMAGE=shlite-complete-ur5:noetic
