<package format="2">
  <name>shlite_custom_rviz</name>
  <version>0.1.0</version>
  <description>Expose the editable RViz robot goal for the custom trajectory editor.</description>
  <maintainer email="maintainer@example.com">SH Lite</maintainer>
  <license>BSD</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>moveit_ros_visualization</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>rviz</depend>
  <export><rviz plugin="${prefix}/plugin_description.xml"/></export>
</package>
